; Engine configuration file.
config_version=5

[application]

config/name="Kingsburg"
config/description="Adattamento digitale di Kingsburg (Andrea Chiarvesio, Luca Iennaco) per uso personale."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/tokens/coat_red.png"
boot_splash/bg_color=Color(0.05, 0.07, 0.12, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
